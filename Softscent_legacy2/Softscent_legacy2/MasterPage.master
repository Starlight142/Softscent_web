<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html lang="th">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Softscent</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Css/site.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <asp:ContentPlaceHolder id="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 fixed-top glass-nav">
                <div class="container-fluid px-4">
                    <a class="navbar-brand brand-logo" href="/index.aspx">Softscent</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/index.aspx">หน้าแรก</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Pages/Products.aspx">สินค้า</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Pages/Custom.aspx">จัดยาดมเอง</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Pages/News.aspx">ข่าวสาร</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Pages/Reviews.aspx">รีวิว</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Pages/Cart.aspx">ตะกร้า</a>
                            </li>
                            <% if (Session["Role"] != null && Session["Role"].ToString() == "Admin") { %>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" href="/Pages/Admin/Dashboard.aspx"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                            <% } %>
                        </ul>
                         <ul class="navbar-nav">
                             <% if (Session["User"] == null) { %>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Pages/Login.aspx">เข้าสู่ระบบ</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Pages/Register.aspx">สมัครสมาชิก</a>
                                </li>
                             <% } else { %>
                                <li class="nav-item">
                                    <span class="nav-link text-dark">สวัสดี, <%= Session["User"] %></span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Pages/Profile.aspx">ข้อมูลส่วนตัว</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Pages/Orders.aspx">ประวัติการสั่งซื้อ</a>
                                </li>
                                <li class="nav-item">
                                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="nav-link text-danger" OnClick="btnLogout_Click">ออกจากระบบ</asp:LinkButton>
                                </li>
                             <% } %>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="main-content-wrapper">
            <div class="container-fluid full-height px-4">
                <main role="main" class="pb-3 pt-5 mt-5">
                    <asp:ContentPlaceHolder id="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

        <footer class="mt-5 pb-5">
            <div class="container-fluid px-4">
                <div class="footer-glass py-4 px-5 text-center d-flex justify-content-between align-items-center">
                    <div class="text-dark fw-bold" style="letter-spacing: 1px; font-size: 0.9rem;">
                        &copy; 2026 SOFTSCENT <span class="text-primary fs-4 mx-2 text-decoration-none">/</span> <span class="text-muted fw-normal">อโรมาเทอราพีไทยระดับพรีเมียม</span>
                    </div>
                    <div class="social-links d-flex gap-3">
                        <a href="#" class="text-dark"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-dark"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-dark"><i class="fab fa-line"></i></a>
                    </div>
                </div>
            </div>
        </footer>

        <style>
            .footer-glass {
                background: rgba(255, 255, 255, 0.7);
                backdrop-filter: blur(15px);
                border-radius: 20px;
                border: 1px solid rgba(255, 255, 255, 0.3);
                box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            }
            .social-links a {
                font-size: 1.25rem;
                transition: all 0.3s;
                opacity: 0.6;
            }
            .social-links a:hover {
                opacity: 1;
                transform: translateY(-3px);
                color: var(--bs-primary) !important;
            }
        </style>

        <!-- Scripts -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/JavaScript/site.js"></script>
    </form>
</body>
</html>
