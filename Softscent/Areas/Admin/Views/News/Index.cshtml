@model IEnumerable<Softscent.Models.News>

@{
    ViewData["Title"] = "Manage News";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage News</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Post New</a>
</div>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Date</th>
            <th>Title</th>
            <th>Summary</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.PublishedDate.ToShortDateString()</td>
            <td>@item.Title</td>
            <td>
                @if(item.Content.Length > 50)
                {
                    @item.Content.Substring(0, 50) <span>...</span>
                }
                else
                {
                    @item.Content
                }
            </td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
}
    </tbody>
</table>
