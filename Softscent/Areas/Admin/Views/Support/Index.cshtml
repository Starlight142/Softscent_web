@model IEnumerable<Softscent.Models.SupportMessage>

@{
    ViewData["Title"] = "Support Requests";
}

<h1>Support Requests</h1>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Date</th>
            <th>User</th>
            <th>Subject</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsResolved ? "" : "table-warning")">
                <td>@item.CreatedDate.ToString("g")</td>
                <td>@item.User?.UserName</td>
                <td>@item.Subject</td>
                <td>
                    @if (item.IsResolved)
                    {
                        <span class="badge bg-success">Resolved</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pending</span>
                    }
                </td>
                <td>
                    <a asp-action="Reply" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Reply</a>
                </td>
            </tr>
        }
    </tbody>
</table>
