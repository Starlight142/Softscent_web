@model IEnumerable<Softscent.Models.Order>

@{
    ViewData["Title"] = "Sales Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Sales Reports - @ViewBag.Period</h1>
    <div class="btn-group">
        <a asp-action="Index" asp-route-period="daily" class="btn btn-outline-primary @(ViewBag.CurrentPeriod == "daily" ? "active" : "")">Daily</a>
        <a asp-action="Index" asp-route-period="monthly" class="btn btn-outline-primary @(ViewBag.CurrentPeriod == "monthly" ? "active" : "")">Monthly</a>
        <a asp-action="Index" asp-route-period="yearly" class="btn btn-outline-primary @(ViewBag.CurrentPeriod == "yearly" ? "active" : "")">Yearly</a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Total Sales (@ViewBag.Period)</h5>
                <h2 class="display-4">@ViewBag.TotalSales.ToString("C")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Total Orders (@ViewBag.Period)</h5>
                <h2 class="display-4">@ViewBag.TotalOrders</h2>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Details</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Order ID</th>
                    <th>User</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.OrderDate.ToString("g")</td>
                        <td>@item.Id</td>
                        <td>@item.UserId</td>
                        <td>@item.OrderDetails.Sum(x => x.Quantity * x.UnitPrice).ToString("C")</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
