@model IEnumerable<Softscent.Models.SupportMessage>

@{
    ViewData["Title"] = "รายการขอความช่วยเหลือ";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>รายการขอความช่วยเหลือของฉัน</h1>
        <a asp-action="Create" class="btn btn-primary">สร้างคำร้องใหม่</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">คุณยังไม่มีรายการขอความช่วยเหลือ</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action flex-column align-items-start mb-3 border rounded shadow-sm">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@item.Subject</h5>
                        <small class="text-muted">@item.CreatedDate.ToString("d MMMM yyyy", new
                    System.Globalization.CultureInfo("th-TH"))</small>
                    </div>
                    <p class="mb-1">@item.Message</p>

                    @if (!string.IsNullOrEmpty(item.AdminReply))
                    {
                        <div class="mt-3 p-3 bg-light rounded border-start border-4 border-primary">
                            <small class="text-uppercase fw-bold text-primary">การตอบกลับจากผู้ดูแล</small>
                            <p class="mb-0 mt-1">@item.AdminReply</p>
                        </div>
                    }
                    else
                    {
                        <small class="text-warning"><i class="fas fa-clock me-1"></i>รอการตอบกลับ</small>
                    }
                </div>
            }
        </div>
    }
</div>
