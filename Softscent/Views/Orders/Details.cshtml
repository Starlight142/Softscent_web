@model Softscent.Models.Order

@{
    ViewData["Title"] = "รายละเอียดคำสั่งซื้อ";
}

<style>
    .order-info-card {
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .status-badge {
        font-size: 0.9rem;
        padding: 8px 16px;
        border-radius: 50px;
    }

    .item-row {
        transition: background 0.2s;
    }

    .item-row:hover {
        background-color: #f8f9fa;
    }

    .detail-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        font-weight: 600;
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">หมายเลขคำสั่งซื้อ #@Model.Id</h1>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-2"></i>กลับไปที่ประวัติการสั่งซื้อ
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card order-info-card mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-shopping-bag me-2 text-primary"></i>รายการสินค้า</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 px-4">สินค้า</th>
                                <th class="border-0">ราคา</th>
                                <th class="border-0 text-center">จำนวน</th>
                                <th class="border-0 text-end px-4">รวมย่อย</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr class="item-row">
                                    <td class="px-4 py-3">
                                        <div class="fw-bold">
                                            @if (detail.Product != null)
                                            {
                                                @detail.Product.NameThai
                                            }
                                            else
                                            {
                                                <span>สินค้าไม่พร้อมจำหน่าย</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(detail.CustomConfiguration))
                                        {
                                            <div class="text-muted small">
                                                <i class="fas fa-magic me-1"></i>
                                                @detail.CustomConfiguration
                                            </div>
                                        }
                                        <div class="mt-2">
                                            <a asp-controller="Reviews" asp-action="Create"
                                                asp-route-productId="@detail.ProductId"
                                                class="btn btn-sm btn-outline-warning rounded-pill">
                                                <i class="fas fa-star me-1"></i>รีวิวสินค้า
                                            </a>
                                        </div>
                                    </td>
                                    <td>@detail.UnitPrice.ToString("N2")</td>
                                    <td class="text-center">@detail.Quantity</td>
                                    <td class="text-end px-4 fw-bold text-primary">@((detail.UnitPrice *
                                    detail.Quantity).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-0 py-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-secondary">ยอดรวมทั้งสิ้น</h5>
                        <h3 class="mb-0 fw-bold text-primary">
                            @Model.TotalAmount.ToString("C")
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card order-info-card mb-4">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="detail-label mb-2">สถานะคำสั่งซื้อ</div>
                        @{
                            var statusColor = Model.Status == "Completed" ? "success" :
                            (Model.Status == "Cancelled" ? "danger" :
                            (Model.Status == "Pending" ? "warning" : "primary"));

                            var statusText = Model.Status;
                            if (statusText == "Completed") statusText = "สำเร็จ";
                            else if (statusText == "Pending") statusText = "รอดำเนินการ";
                            else if (statusText == "Cancelled") statusText = "ยกเลิก";
                            else if (statusText == "Processing") statusText = "กำลังปรุง";
                            else if (statusText == "Shipped") statusText = "จัดส่งแล้ว";
                        }
                        <span class="badge status-badge bg-@statusColor">
                            @statusText
                        </span>
                    </div>
                    <div class="mb-4">
                        <div class="detail-label mb-2">วันที่สั่งซื้อ</div>
                        <div class="fw-bold">
                            @Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")
                        </div>
                    </div>
                    <hr />
                    <div class="mb-4">
                        <div class="detail-label mb-2">ข้อมูลการจัดส่ง</div>
                        <div class="fw-bold">
                            @Model.ShippingMethod Delivery
                        </div>
                        <div class="text-muted small mt-1">
                            @Model.ShippingAddress
                        </div>
                    </div>
                    <div class="mb-0">
                        <div class="detail-label mb-2">การชำระเงิน</div>
                        <div class="fw-bold">
                            @Model.PaymentMethod
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
